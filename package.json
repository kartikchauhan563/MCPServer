{
  "name": "demo-mcp-server",
  "version": "2.0.0",
  "description": "Headless MCP server (Mongo + Excel agents) for any React/HTTP client",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/mcp/stdio.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "api": "tsx src/http/listen.ts",
    "dev": "tsx watch src/http/listen.ts",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/mcp/stdio.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:mongo": "tsx scripts/mongo-smoke.ts",
    "smoke:excel": "tsx scripts/excel-smoke.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mongodb",
    "excel"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "mongodb": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
