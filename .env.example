MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.kptcv6f.mongodb.net/?appName=Cluster0
MONGODB_DB=demo_mcp

# Optional: public DNS resolvers for mongodb+srv on networks that block SRV
# lookups. Leave EMPTY on Render/other managed hosts.
MONGODB_DNS_SERVERS=
MONGODB_TIMEOUT_MS=8000

# Local dev only. On Render, do NOT set PORT or HTTP_HOST — Render injects PORT
# and the app must bind 0.0.0.0. A loopback HTTP_HOST makes it unreachable.
PORT=3000
HTTP_HOST=127.0.0.1

CORS_ORIGIN=*
EXCEL_FILE=data/workbook.xlsx

# Shared secret for any React / HTTP client
CLIENT_API_KEY=change-me

# Local only — gitignored. Do not commit.
# Server-side LLM. Never use VITE_* for secrets.
LLM_API_KEY=
LLM_TIMEOUT_MS=30000

IPA_AI_PROVIDER=custom
IPA_LLM_MODEL=azure.gpt-4o
IPA_OPENAI_BASE_URL=https://genai-sharedservice-americas.pwcinternal.com

# NOTE: this host is PwC-internal and is NOT reachable from Render. Leave the
# LLM vars unset when deploying; the server falls back to keyword mode.
LLM_API_URL=https://genai-sharedservice-americas.pwcinternal.com/v1/chat/completions
LLM_MODEL=azure.gpt-4o
